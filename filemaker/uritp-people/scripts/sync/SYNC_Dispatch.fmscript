# SCRIPT: sync DISPATCH
# FOLDER: sync
# Walks every record the pull touched this session and routes it to the right handler.
# System-agnostic: knows tables, not APIs.
# Param (JSON): the context block from sync RUN.
# Returns (JSON): { "ok" : 1|0, "count" : n, "adopted" : n, "compared" : n, "skipped" : n }
Set Error Capture [ On ]
Allow User Abort [ Off ]
Set Variable [ $sessionPK ; Value: JSONGetElement ( Get ( ScriptParameter ) ; "session" ) ]
Set Variable [ $containerPK ; Value: JSONGetElement ( Get ( ScriptParameter ) ; "container" ) ]
Set Variable [ $pullKey ; Value: JSONGetElement ( Get ( ScriptParameter ) ; "pullKey" ) ]
#
If [ IsEmpty ( $sessionPK ) or IsEmpty ( $containerPK ) or IsEmpty ( $pullKey ) ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "error" ; "Missing context. sync RUN must pass session, container, pullKey." ; JSONString ) ]
End If
#
# ---------- resolve the handler ----------
Set Variable [ $targetTable ; Value: ExecuteSQL ( "SELECT tt.fm_BaseTableName FROM xt_CONTAINERS c JOIN Target_Tables tt ON c.fk_TargetTable = tt.PrimaryKey WHERE c.PrimaryKey = ?" ; "" ; "" ; $containerPK ) ]
If [ IsEmpty ( $targetTable ) or Left ( $targetTable ; 1 ) = "?" ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "error" ; "Container has no target table, or the join failed." ; JSONString ) ]
End If
#
# ---------- get every record pulled this session ----------
Set Variable [ $pulledRecords ; Value: ExecuteSQL ( "SELECT DISTINCT fk_xtRecord FROM sync_EVENTS WHERE fk_Session = ? AND fk_vAction = ?" ; "" ; "" ; $sessionPK ; $pullKey ) ]
If [ IsEmpty ( $pulledRecords ) ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 1 ; JSONNumber ) ; "count" ; 0 ; JSONNumber ) ]
End If
#
Set Variable [ $total ; Value: ValueCount ( $pulledRecords ) ]
Set Variable [ $countAdopt ; Value: 0 ]
Set Variable [ $countCompare ; Value: 0 ]
Set Variable [ $countSkipped ; Value: 0 ]
Set Variable [ $i ; Value: 0 ]
#
Loop [ Flush: Always ]
	Set Variable [ $i ; Value: $i + 1 ]
	Exit Loop If [ $i > $total ]
	Set Variable [ $recPK ; Value: GetValue ( $pulledRecords ; $i ) ]
	#
	Set Variable [ $joinPK ; Value: ExecuteSQL ( "SELECT PrimaryKey FROM XTERNAL_JOINS WHERE fk_xtRecord = ?" ; "" ; "" ; $recPK ) ]
	#
	If [ IsEmpty ( $joinPK ) ]
		Set Variable [ $mode ; Value: "adopt" ]
	Else
		Set Variable [ $mode ; Value: "compare" ]
	End If
	#
	Set Variable [ $handlerParam ; Value: JSONSetElement ( Get ( ScriptParameter ) ; [ "record" ; $recPK ; JSONString ] ; [ "mode" ; $mode ; JSONString ] ) ]
	#
	If [ $targetTable = "PEOPLE" ]
		Perform Script [ Specified: From list ; "PERSON_Upsert_From_xtRecord" ; Parameter: $handlerParam ]
		Set Variable [ $handlerResult ; Value: Get ( ScriptResult ) ]
		If [ JSONGetElement ( $handlerResult ; "ok" ) = 1 ]
			If [ $mode = "adopt" ]
				Set Variable [ $countAdopt ; Value: $countAdopt + 1 ]
			Else
				Set Variable [ $countCompare ; Value: $countCompare + 1 ]
			End If
		Else
			Set Variable [ $countSkipped ; Value: $countSkipped + 1 ]
		End If
	Else
		Set Variable [ $countSkipped ; Value: $countSkipped + 1 ]
	End If
End Loop
#
Show Custom Dialog [ "Dispatch" ; "Records: " & $total & "¶Adopted: " & $countAdopt & "¶Compared: " & $countCompare & "¶Skipped: " & $countSkipped ]
Exit Script [ Text Result: JSONSetElement ( "{}" ;
	[ "ok" ; 1 ; JSONNumber ] ;
	[ "count" ; $total ; JSONNumber ] ;
	[ "adopted" ; $countAdopt ; JSONNumber ] ;
	[ "compared" ; $countCompare ; JSONNumber ] ;
	[ "skipped" ; $countSkipped ; JSONNumber ] ) ]
