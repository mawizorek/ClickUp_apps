# SCRIPT: refresh | xt_fields
# FOLDER: sync
# Generic. Refreshes one container's xt_FIELDS rows from whatever system owns it.
# Holds NO knowledge of any system's API or JSON. That lives in the adapter, per D-046.
# Param (JSON): { "container" : "<xt_CONTAINERS PrimaryKey>" }
# Returns (JSON): { "ok" : 1|0, "system" : "<name>", "updated" : n, "missing" : n, "native" : n, "error" : "<msg>" }
Set Error Capture [ On ]
Allow User Abort [ Off ]
Set Variable [ $containerPK ; Value: JSONGetElement ( Get ( ScriptParameter ) ; "container" ) ]
If [ IsEmpty ( $containerPK ) ]
	Show Custom Dialog [ "Field refresh" ; "No container was passed. Param is { \"container\" : \"<xt_CONTAINERS PrimaryKey>\" }." ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "error" ; "No container passed." ; JSONString ) ]
End If
#
# The container and the system that owns it, in one query.
Set Variable [ $row ; Value: ExecuteSQL ( "SELECT s.PrimaryKey, s.Name FROM xt_CONTAINERS c JOIN xt_SYSTEMS s ON c.fk_xtSystem = s.PrimaryKey WHERE c.PrimaryKey = ?" ; "|" ; "" ; $containerPK ) ]
If [ IsEmpty ( $row ) or Left ( $row ; 1 ) = "?" ]
	Show Custom Dialog [ "Field refresh" ; "That container has no system, or the id was not found." ]
	Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "error" ; "Container has no system or was not found." ; JSONString ) ]
End If
Set Variable [ $systemPK ; Value: GetValue ( Substitute ( $row ; "|" ; ¶ ) ; 1 ) ]
Set Variable [ $systemName ; Value: GetValue ( Substitute ( $row ; "|" ; ¶ ) ; 2 ) ]
#
# Dispatch. The adapter is handed two keys and reads its own credentials.
Set Variable [ $param ; Value: JSONSetElement ( "{}" ; [ "container" ; $containerPK ; JSONString ] ; [ "system" ; $systemPK ; JSONString ] ) ]
If [ $systemName = "ClickUp" ]
	Perform Script [ Specified: From list ; "adapter | refresh cu_Fields" ; Parameter: $param ]
	Exit Script [ Text Result: Get ( ScriptResult ) ]
End If
# No adapter for this system yet.
Show Custom Dialog [ "Field refresh" ; "No field-refresh adapter exists for the system " & Quote ( $systemName ) & "." ]
Exit Script [ Text Result: JSONSetElement ( JSONSetElement ( "{}" ; "ok" ; 0 ; JSONNumber ) ; "system" ; $systemName ; JSONString ) ]
