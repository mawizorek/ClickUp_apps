# txn_Commit
# Closes the pseudo-transaction. This is the ONLY Commit Records allowed in a write routine.
# Returns (JSON): { ok } or { ok:false, error, errorCode }
# On error it leaves the record UNCOMMITTED and hands the rollback decision to the caller.

Set Error Capture [ On ]

If [ $$TXN_ACTIVE <> 1 ]
	Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; False ; JSONBoolean ] ; [ "error" ; "txn_Commit called with no open transaction" ; JSONString ] ) ]
End If

# Return to the parent so the commit lands on the anchor, not wherever the routine ended up
Go to Layout [ $$TXN_PARENT_TABLE ]

Commit Records/Requests [ With dialog: Off ]
Set Variable [ $err ; Value: Get ( LastError ) ]

If [ $err ]
	Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; False ; JSONBoolean ] ; [ "error" ; "commit failed in txn " & $$TXN_LABEL ; JSONString ] ; [ "errorCode" ; $err ; JSONNumber ] ) ]
End If

# Clear state only after a clean commit
Set Variable [ $$TXN_ACTIVE ; Value: "" ]
Set Variable [ $$TXN_ID ; Value: "" ]
Set Variable [ $$TXN_PARENT_TABLE ; Value: "" ]
Set Variable [ $$TXN_PARENT_ID ; Value: "" ]
Set Variable [ $$TXN_LABEL ; Value: "" ]

Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; True ; JSONBoolean ] ) ]
