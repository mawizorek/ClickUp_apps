# 10_UI__Set_Hub_Tab
# Switches the hub's active tab. Display state only, no data mutation.
# Param (JSON): { tab (req), subtab (opt) }
# Returns (JSON): { ok, tab }

Set Error Capture [ On ]
Set Variable [ $p ; Value: Get ( ScriptParameter ) ]
Set Variable [ $tab ; Value: JSONGetElement ( $p ; "tab" ) ]
Set Variable [ $subtab ; Value: JSONGetElement ( $p ; "subtab" ) ]

If [ IsEmpty ( $tab ) ]
	Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; False ; JSONBoolean ] ; [ "error" ; "no tab" ; JSONString ] ) ]
End If

# Keep this list in sync with the hub layout's panel names
Set Variable [ $known ; Value: "Summary¶Schedule¶Ledger¶Receipts¶Payoff¶Documents" ]

If [ not PatternCount ( $known ; $tab ) ]
	Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; False ; JSONBoolean ] ; [ "error" ; "unknown tab: " & $tab ; JSONString ] ) ]
End If

Set Field [ GLOBAL_USE_VARIABLES::g_HubTab ; $tab ]

If [ not IsEmpty ( $subtab ) ]
	Set Field [ GLOBAL_USE_VARIABLES::g_HubSubTab ; $subtab ]
End If

Refresh Window [ ]

Exit Script [ Result: JSONSetElement ( "{}" ; [ "ok" ; True ; JSONBoolean ] ; [ "tab" ; $tab ; JSONString ] ) ]
